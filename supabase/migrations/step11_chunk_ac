INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('کرانچ میز شیب منفی', '', ARRAY['شکمی']::text[], ARRAY[]::text[], 'strength', ARRAY['نیمکت']::text[], 'beginner', 'both', 'خوابیده روی زمین، زانو خم، دست‌ها پشت سر یا روی سینه. با بازدم، سر و شانه‌ها را از زمین جدا کنید. در بالا مکث کنید و با کنترل برگردید.', 'گردن راحت، دست‌ها نکشید. انقباض شکم را احساس کنید. نفس در بالا رها کنید.', 'در صورت درد گردن یا کمر، فرم را اصلاح کنید.', 'https://drive.google.com/file/d/1Pad2t8Rqg9hNujyerUXGFo_8o8G8g_Oz/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت پا دمبل', 'Dumbbell Hamstring Curl', ARRAY['جلو بازو']::text[], ARRAY['ساعد']::text[], 'strength', ARRAY['دمبل','بارفیکس']::text[], 'beginner', 'both', 'ایستاده، پاها به عرض شانه، آرنج‌ها نزدیک بدن. هالتر یا دمبل را با کف دست به سمت بالا بکشید. آرنج‌ها ثابت بمانند. در بالا مکث کنید و با کنترل پایین بیاورید.', 'آرنج‌ها ثابت کنار بدن، تاب خوردن دست مجاز نیست. حرکت را کنترل و آرام انجام دهید.', 'در صورت درد مچ یا آرنج، وزنه را کاهش دهید.', 'https://drive.google.com/file/d/1VZIQbZA-GxJ3hSIiWClQE7gstrSoRngx/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
