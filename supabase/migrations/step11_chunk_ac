INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت بازو تک دمبل نشسته', '', ARRAY['پشت‌بازو']::text[], ARRAY['سینه']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید یا ایستاده، آرنج‌ها ثابت. دمبل یا هالتر را از پشت سر به سمت بالا باز کنید. آرنج‌ها نزدیک سر بمانند. با کنترل به وضعیت اولیه برگردید.', 'آرنج‌ها ثابت، نزدیک سر یا بدن بمانند. از باز شدن آرنج‌ها به بیرون خودداری کنید.', 'در صورت درد آرنج، از وزنه سبک‌تر استفاده کنید.', 'https://drive.google.com/file/d/1M3HuOV27_6QapeUW0DyD8VjfMSnxkyUb/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پلانک روی زانو', '', ARRAY['شکمی']::text[], ARRAY['کمر']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'both', 'خوابیده روی زمین، زانو خم، دست‌ها پشت سر یا روی سینه. با بازدم، سر و شانه‌ها را از زمین جدا کنید. در بالا مکث کنید و با کنترل برگردید.', 'گردن راحت، دست‌ها نکشید. انقباض شکم را احساس کنید. نفس در بالا رها کنید.', 'در صورت درد گردن یا کمر، فرم را اصلاح کنید.', 'https://drive.google.com/file/d/13X_QuIByF4bX9vFuAO_S0McHLCn5dZ_m/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
