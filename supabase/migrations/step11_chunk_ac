INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پرس زیرسینه اسمیت', 'Smith Machine Decline Bench Press', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو','سرشانه']::text[], 'strength', ARRAY['ماشین','نیمکت']::text[], 'intermediate', 'gym', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/18E_936AhyR3DKXcFUp07jj8Q8C8KXxwM/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
