INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('لانج معکوس پای جلو بالا دمبل', '', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/1OBogmnJS5Q0o8e1ODWVwEto-5EuPzyoY/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت بازو دمبل تک دست پشت سر', 'Single Arm Dumbbell Skull Crusher', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1AjGgsfchDGPaT2dBn3MY_V2KlerMHvwD/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
