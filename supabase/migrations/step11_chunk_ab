INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('گابلت لانج', '', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'gym', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/1OCTf_nd1RKK9QrengvkRWXYWN_u19DWk/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
