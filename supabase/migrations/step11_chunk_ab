INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('دمبل دست عکس خوابیده به سینه میز شیب مثبت', '', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['دمبل','نیمکت']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1045FHC6Mo1UKAmZnLiulGMZfZW_JIs9u/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پارویی اسمیت ایستاده دست باز (کول اسمیت دست باز)', '', ARRAY['سرشانه']::text[], ARRAY['ترپز','جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['ماشین']::text[], 'intermediate', 'gym', 'ایستاده، پاها به عرض شانه، شکم سفت. دمبل‌ها را در خط شانه نگه دارید. با بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها بالای سر صاف شوند. با کنترل به وضعیت اولیه برگردید.', 'شانه‌ها پایین و دور از گوش. قفسه سینه بالا، شکم سفت. از قفل کردن کامل آرنج در بالا خودداری کنید.', 'در صورت درد سرشانه یا کتف، زاویه را تغییر دهید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1A9jOxAVO1cTYuDJAuOnl588YgRN2ekQ2/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
