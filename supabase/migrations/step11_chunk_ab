INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پلانک کپنهاگ جمع', 'Copenhagen Tuck Plank', ARRAY['شکمی']::text[], ARRAY['کمر']::text[], 'corrective', ARRAY['بدون تجهیزات']::text[], 'beginner', 'both', 'خوابیده روی زمین، زانو خم، دست‌ها پشت سر یا روی سینه. با بازدم، سر و شانه‌ها را از زمین جدا کنید. در بالا مکث کنید و با کنترل برگردید.', 'گردن راحت، دست‌ها نکشید. انقباض شکم را احساس کنید. نفس در بالا رها کنید.', 'در صورت درد گردن یا کمر، فرم را اصلاح کنید.', 'https://drive.google.com/file/d/1JksPznfHuz6LBfU3MwWwgZNJ3ishnG4z/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('کیک بک سیمکش', '', ARRAY['باسن']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['ماشین','کش']::text[], 'beginner', 'gym', 'خوابیده روی زمین، زانو خم، کف پا روی زمین. باسن را به سمت بالا فشار دهید تا تنه و ران‌ها در یک خط قرار گیرند. در بالا مکث کنید و با کنترل پایین بیاورید.', 'فشار از طریق پاشنه، نه کمر. در بالا انقباض باسن را احساس کنید.', 'در صورت درد کمر، فرم را اصلاح کنید یا وزنه را کاهش دهید.', 'https://drive.google.com/file/d/1OOutg_rMGVN2gAoBqOnp4IcvCqEAyHeS/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('لانج پا جمع دمبل', '', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/1EcV47oCxJU8l_kzKSrbq9a2uyvg6Kmsb/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('فلای دمبل میز شیب منفی با چرخش', 'Decline Dumbbell Fly with Twist', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1Uyh6YC84pPiddYl3M2nzSWfsdUr642Va/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
