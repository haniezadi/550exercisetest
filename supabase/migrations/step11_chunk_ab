INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ساق تک پا دستگاه پرس پا', 'Leg Press Machine Single Leg Calf Raises', ARRAY['ساق']::text[], ARRAY['باسن','پشت‌ران','پشت‌بازو']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'ایستاده، نوک پنجه روی لبه دستگاه یا صفحه. با کنترل پایین بروید تا کشش کامل در ساق احساس شود. سپس با فشار نوک پنجه به بالا برگردید.', 'کشش کامل در پایین، انقباض کامل در بالا. مکث کوتاه در بالا برای انقباخت بهتر.', 'در صورت درد مچ پا یا تاندون آشیل، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1KEtoC9oCjTno6S4ydAIqfodM1QhgQfxV/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
