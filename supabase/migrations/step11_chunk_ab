INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('شنا با کش بازو', 'Arm Banded Push-Up', ARRAY['کل‌بدن']::text[], ARRAY[]::text[], 'strength', ARRAY['کش']::text[], 'beginner', 'both', 'ایستاده، پاها به عرض شانه. حرکت را با فرم صحیح و کنترل کامل انجام دهید. تمام بدن درگیر است.', 'هماهنگی تنفس با حرکت، فرم صحیح اولویت دارد.', 'در صورت درد هر ناحیه، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1Ei_gibRKrSmKqyTGuig1Cr7pf79ntHs5/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('اسکوات اسمیت', '', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['ماشین']::text[], 'intermediate', 'gym', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/13Nb07OFwPiwXofe7vhvscOndL4fglvVB/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
