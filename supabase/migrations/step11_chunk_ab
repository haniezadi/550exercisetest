INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پرس پا تک پا دستگاه', 'Leg Press Machine Single Leg Press', ARRAY['پشت']::text[], ARRAY['باسن','پشت‌ران','پشت‌بازو']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'تنه را از کمر خم کنید، کمر صاف، نگاه به جلو. هالتر یا دمبل را با کنترل به سمت زیر شکم بکشید. آرنج‌ها نزدیک بدن، کتف‌ها فشرده شوند. در پایین مکث کنید و با کنترل رها کنید.', 'کمر صفت نگه دارید، از کمان‌برداری کمر خودداری کنید. کتف‌ها را در پایین فشرده کنید.', 'در صورت درد کمر، از وزنه سبک‌تر استفاده کنید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1Sj3CSUkTbxPOKfMtpTDnKXaeYO52XWoH/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
