INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('بارفیکس دست عکس', '', ARRAY['پشت']::text[], ARRAY['پشت‌بازو','سرشانه']::text[], 'strength', ARRAY['بارفیکس']::text[], 'advanced', 'both', 'تنه را از کمر خم کنید، کمر صاف، نگاه به جلو. هالتر یا دمبل را با کنترل به سمت زیر شکم بکشید. آرنج‌ها نزدیک بدن، کتف‌ها فشرده شوند. در پایین مکث کنید و با کنترل رها کنید.', 'کمر صفت نگه دارید، از کمان‌برداری کمر خودداری کنید. کتف‌ها را در پایین فشرده کنید.', 'در صورت درد کمر، از وزنه سبک‌تر استفاده کنید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1CIyMLGVRjr6pvgxSTVJaFrpKo9LOsU46/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت ساعد با دمبل تک', '', ARRAY['کل‌بدن']::text[], ARRAY[]::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'ایستاده، پاها به عرض شانه. حرکت را با فرم صحیح و کنترل کامل انجام دهید. تمام بدن درگیر است.', 'هماهنگی تنفس با حرکت، فرم صحیح اولویت دارد.', 'در صورت درد هر ناحیه، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1QkUugddc2dkIBKXMTzI7Vh1sccqNpkdZ/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
