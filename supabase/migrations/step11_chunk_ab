INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('هک اسکوات دستگاه', 'Hack Squat Machine', ARRAY['پشت']::text[], ARRAY['باسن','پشت‌ران','پشت‌بازو']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'تنه را از کمر خم کنید، کمر صاف، نگاه به جلو. هالتر یا دمبل را با کنترل به سمت زیر شکم بکشید. آرنج‌ها نزدیک بدن، کتف‌ها فشرده شوند. در پایین مکث کنید و با کنترل رها کنید.', 'کمر صفت نگه دارید، از کمان‌برداری کمر خودداری کنید. کتف‌ها را در پایین فشرده کنید.', 'در صورت درد کمر، از وزنه سبک‌تر استفاده کنید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1TCTjKGCrrfPlzk2b1-PUvQ6uPbIds144/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پرس سینه هالتر روی زمین دست باز', 'Wide Grip Barbell Floor Press', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['هالتر']::text[], 'intermediate', 'both', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1U0qNTpuilQP2BDWKohOeYmNaa8b1kICc/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
