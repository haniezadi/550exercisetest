INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('کرانچ معکوس میز شیب مثبت', '', ARRAY['شکمی']::text[], ARRAY[]::text[], 'strength', ARRAY['نیمکت']::text[], 'beginner', 'both', 'خوابیده روی زمین، زانو خم، دست‌ها پشت سر یا روی سینه. با بازدم، سر و شانه‌ها را از زمین جدا کنید. در بالا مکث کنید و با کنترل برگردید.', 'گردن راحت، دست‌ها نکشید. انقباض شکم را احساس کنید. نفس در بالا رها کنید.', 'در صورت درد گردن یا کمر، فرم را اصلاح کنید.', 'https://drive.google.com/file/d/1DspDDx43FmTJF09U6VgqiqqA8jRNkVVC/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پایک پوش آپ', '', ARRAY['کل‌بدن']::text[], ARRAY[]::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'gym', 'ایستاده، پاها به عرض شانه. حرکت را با فرم صحیح و کنترل کامل انجام دهید. تمام بدن درگیر است.', 'هماهنگی تنفس با حرکت، فرم صحیح اولویت دارد.', 'در صورت درد هر ناحیه، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1-9ziHMDYJ0eFFpU9PuO0umrS7_8VaPTp/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('لانج دمبل', '', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/13TQPJVFPwb6zETzv4lJiZtVcs9mnm3xB/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ددلیفت اسمیت', '', ARRAY['پشت‌ران']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['ماشین']::text[], 'advanced', 'gym', 'ایستاده یا خوابیده روی دستگاه. با کنترل پاشنه‌ها را به سمت باسن بکشید. در بالا مکث کنید و با کنترل رها کنید. کمر صفت نگه دارید.', 'کشش کامل در پایین، انقباض کامل در بالا. از تاب خوردن دستگاه خودداری کنید.', 'در صورت درد زانو یا کمر، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1PMmL-cMHYdo3ooaR0_PzoRpbBLO7eeXa/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پرس سینه سیمکش متناوب', 'Alternating Cable Bench Press', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['ماشین','نیمکت']::text[], 'beginner', 'gym', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1KEpR3csWCdPR0Ad8ggL8lMFUabndVPGB/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
