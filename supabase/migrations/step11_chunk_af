INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ساق سیمکش', 'Cable Calf Raise', ARRAY['ساق']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'ایستاده، نوک پنجه روی لبه دستگاه یا صفحه. با کنترل پایین بروید تا کشش کامل در ساق احساس شود. سپس با فشار نوک پنجه به بالا برگردید.', 'کشش کامل در پایین، انقباض کامل در بالا. مکث کوتاه در بالا برای انقباخت بهتر.', 'در صورت درد مچ پا یا تاندون آشیل، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/14i7qMAqcOUS_2WwwoV2UuxRejWG1_eS6/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('هیپ تراست سیمکش', 'Cable Hip Thrust', ARRAY['باسن']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'خوابیده روی زمین، زانو خم، کف پا روی زمین. باسن را به سمت بالا فشار دهید تا تنه و ران‌ها در یک خط قرار گیرند. در بالا مکث کنید و با کنترل پایین بیاورید.', 'فشار از طریق پاشنه، نه کمر. در بالا انقباض باسن را احساس کنید.', 'در صورت درد کمر، فرم را اصلاح کنید یا وزنه را کاهش دهید.', 'https://drive.google.com/file/d/19GKTejOflq-XRsfIX-8C7AD5wps7DLFu/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ددلیفت رومانیایی پا متفاوت', 'Staggered Stance Romanian Deadlift', ARRAY['پشت‌ران']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'advanced', 'gym', 'ایستاده یا خوابیده روی دستگاه. با کنترل پاشنه‌ها را به سمت باسن بکشید. در بالا مکث کنید و با کنترل رها کنید. کمر صفت نگه دارید.', 'کشش کامل در پایین، انقباض کامل در بالا. از تاب خوردن دستگاه خودداری کنید.', 'در صورت درد زانو یا کمر، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1Tip3wuhKTVyVpKfTQp4D0DYFl0si5h-A/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('لانج به طرفین با وزن بدن', '', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'both', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/1ZsB3db1L3ev1NoFIrgUggb40iLZ14biH/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
