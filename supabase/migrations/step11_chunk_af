INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پرس سینه با هالتر', 'Barbell Bench Press', ARRAY['سینه']::text[], ARRAY['سرشانه','پشت‌بازو']::text[], 'strength', ARRAY['هالتر','نیمکت']::text[], 'intermediate', 'gym', 'روی نیمکت دراز بکشید، هالتر را تا قفسه سینه پایین بیاورید و بالا فشار دهید.', 'کمربندی شانه به نیمکت، پاها روی زمین', 'آسیب سرشانه', '', true, false, ARRAY['بالاتنه','پایه']::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('بارفیکس دست باز دستگاه کمکی', '', ARRAY['پشت']::text[], ARRAY['پشت‌بازو','سرشانه']::text[], 'strength', ARRAY['ماشین','بارفیکس']::text[], 'advanced', 'gym', 'تنه را از کمر خم کنید، کمر صاف، نگاه به جلو. هالتر یا دمبل را با کنترل به سمت زیر شکم بکشید. آرنج‌ها نزدیک بدن، کتف‌ها فشرده شوند. در پایین مکث کنید و با کنترل رها کنید.', 'کمر صفت نگه دارید، از کمان‌برداری کمر خودداری کنید. کتف‌ها را در پایین فشرده کنید.', 'در صورت درد کمر، از وزنه سبک‌تر استفاده کنید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1J13atycmU_gmdOoZVTpvcTYahQ0Oqaww/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
