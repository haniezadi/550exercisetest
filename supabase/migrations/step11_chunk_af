INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ددلیفت ترپ بار پا متفاوت', 'Staggered Stance Trap Bar Deadlift', ARRAY['پشت‌ران']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'advanced', 'gym', 'ایستاده یا خوابیده روی دستگاه. با کنترل پاشنه‌ها را به سمت باسن بکشید. در بالا مکث کنید و با کنترل رها کنید. کمر صفت نگه دارید.', 'کشش کامل در پایین، انقباض کامل در بالا. از تاب خوردن دستگاه خودداری کنید.', 'در صورت درد زانو یا کمر، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/13ADpr82nVe1nEPS4cJeqtfIueP0s9wFl/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
