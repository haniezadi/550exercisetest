INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('کرانچ روی نیمکت', 'Bench Crunch', ARRAY['شکمی']::text[], ARRAY[]::text[], 'strength', ARRAY['نیمکت']::text[], 'beginner', 'both', 'خوابیده روی زمین، زانو خم، دست‌ها پشت سر یا روی سینه. با بازدم، سر و شانه‌ها را از زمین جدا کنید. در بالا مکث کنید و با کنترل برگردید.', 'گردن راحت، دست‌ها نکشید. انقباض شکم را احساس کنید. نفس در بالا رها کنید.', 'در صورت درد گردن یا کمر، فرم را اصلاح کنید.', 'https://drive.google.com/file/d/1Z_q2Ef023TUNfdVDA65eO-ukTlviIHrC/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ساق ایستاده دستگاه', '', ARRAY['ساق']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'ایستاده، نوک پنجه روی لبه دستگاه یا صفحه. با کنترل پایین بروید تا کشش کامل در ساق احساس شود. سپس با فشار نوک پنجه به بالا برگردید.', 'کشش کامل در پایین، انقباض کامل در بالا. مکث کوتاه در بالا برای انقباخت بهتر.', 'در صورت درد مچ پا یا تاندون آشیل، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1Z5qkDWDB14fmawQWNEEPJZaS2nt7O9Xb/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
