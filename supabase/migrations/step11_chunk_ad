INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت بازو کابل خوابیده به سینه میز شیب مثبت', '', ARRAY['پشت‌بازو']::text[], ARRAY['سینه']::text[], 'strength', ARRAY['ماشین','نیمکت']::text[], 'beginner', 'gym', 'روی نیمکت دراز بکشید یا ایستاده، آرنج‌ها ثابت. دمبل یا هالتر را از پشت سر به سمت بالا باز کنید. آرنج‌ها نزدیک سر بمانند. با کنترل به وضعیت اولیه برگردید.', 'آرنج‌ها ثابت، نزدیک سر یا بدن بمانند. از باز شدن آرنج‌ها به بیرون خودداری کنید.', 'در صورت درد آرنج، از وزنه سبک‌تر استفاده کنید.', 'https://drive.google.com/file/d/1U9BNzkadoO3RH03BCoutnHgwjlTu6r92/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
