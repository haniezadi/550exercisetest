INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت بازو دیپ میز', '', ARRAY['پشت‌بازو']::text[], ARRAY['سینه']::text[], 'strength', ARRAY['نیمکت']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید یا ایستاده، آرنج‌ها ثابت. دمبل یا هالتر را از پشت سر به سمت بالا باز کنید. آرنج‌ها نزدیک سر بمانند. با کنترل به وضعیت اولیه برگردید.', 'آرنج‌ها ثابت، نزدیک سر یا بدن بمانند. از باز شدن آرنج‌ها به بیرون خودداری کنید.', 'در صورت درد آرنج، از وزنه سبک‌تر استفاده کنید.', 'https://drive.google.com/file/d/1LbAf252y6mBGnDwHQtKqreYA2K_nxwEb/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('بارفیکس دستگاه کمکی', '', ARRAY['پشت']::text[], ARRAY['پشت‌بازو','سرشانه']::text[], 'strength', ARRAY['ماشین','بارفیکس']::text[], 'advanced', 'gym', 'تنه را از کمر خم کنید، کمر صاف، نگاه به جلو. هالتر یا دمبل را با کنترل به سمت زیر شکم بکشید. آرنج‌ها نزدیک بدن، کتف‌ها فشرده شوند. در پایین مکث کنید و با کنترل رها کنید.', 'کمر صفت نگه دارید، از کمان‌برداری کمر خودداری کنید. کتف‌ها را در پایین فشرده کنید.', 'در صورت درد کمر، از وزنه سبک‌تر استفاده کنید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1099XWf9bTuUw4-GLrpSKie1gF3zuuXmD/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
