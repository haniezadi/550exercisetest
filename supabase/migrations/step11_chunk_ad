INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('فیس پول', '', ARRAY['سرشانه']::text[], ARRAY['ترپز','جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'gym', 'ایستاده، پاها به عرض شانه، شکم سفت. دمبل‌ها را در خط شانه نگه دارید. با بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها بالای سر صاف شوند. با کنترل به وضعیت اولیه برگردید.', 'شانه‌ها پایین و دور از گوش. قفسه سینه بالا، شکم سفت. از قفل کردن کامل آرنج در بالا خودداری کنید.', 'در صورت درد سرشانه یا کتف، زاویه را تغییر دهید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1JVfOb8bt69Tpj_kX9BQKmS80FphtG5qB/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
