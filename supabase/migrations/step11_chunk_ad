INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پل باسن دمبل', '', ARRAY['باسن']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'خوابیده روی زمین، زانو خم، کف پا روی زمین. باسن را به سمت بالا فشار دهید تا تنه و ران‌ها در یک خط قرار گیرند. در بالا مکث کنید و با کنترل پایین بیاورید.', 'فشار از طریق پاشنه، نه کمر. در بالا انقباض باسن را احساس کنید.', 'در صورت درد کمر، فرم را اصلاح کنید یا وزنه را کاهش دهید.', 'https://drive.google.com/file/d/1Us_3V9njilQAfVI91D4GU_m3odVBQLy1/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('فشار دادن زمین حالت شنا', '', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1XCTO0uhx06uG44WCWa_vvmQYlevh8por/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ددلیفت رومانیایی لندماین تک پا', 'Landmine Single Leg Romanian Deadlift', ARRAY['پشت‌ران']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['هالتر']::text[], 'advanced', 'both', 'ایستاده یا خوابیده روی دستگاه. با کنترل پاشنه‌ها را به سمت باسن بکشید. در بالا مکث کنید و با کنترل رها کنید. کمر صفت نگه دارید.', 'کشش کامل در پایین، انقباض کامل در بالا. از تاب خوردن دستگاه خودداری کنید.', 'در صورت درد زانو یا کمر، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1BWp1taoEIN570Ik4ZipnlXhmcGmwNWKu/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('جلوبازو دمبل چکشی از بالا تکیه سینه', 'Chest Supported Top Down Dumbbell Hammer Curl', ARRAY['جلو بازو']::text[], ARRAY['ساعد']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'ایستاده، پاها به عرض شانه، آرنج‌ها نزدیک بدن. هالتر یا دمبل را با کف دست به سمت بالا بکشید. آرنج‌ها ثابت بمانند. در بالا مکث کنید و با کنترل پایین بیاورید.', 'آرنج‌ها ثابت کنار بدن، تاب خوردن دست مجاز نیست. حرکت را کنترل و آرام انجام دهید.', 'در صورت درد مچ یا آرنج، وزنه را کاهش دهید.', 'https://drive.google.com/file/d/1107UUH2eK5YBFG-8TIidnFSXwIO4_nNM/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
