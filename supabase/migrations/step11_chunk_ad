INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('کرانچ معکوس سیمکش', 'Cable Reverse Crunch', ARRAY['شکمی']::text[], ARRAY[]::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'خوابیده روی زمین، زانو خم، دست‌ها پشت سر یا روی سینه. با بازدم، سر و شانه‌ها را از زمین جدا کنید. در بالا مکث کنید و با کنترل برگردید.', 'گردن راحت، دست‌ها نکشید. انقباض شکم را احساس کنید. نفس در بالا رها کنید.', 'در صورت درد گردن یا کمر، فرم را اصلاح کنید.', 'https://drive.google.com/file/d/1Kkb87dlH11uzlRjddDd-ShApDIKLKt4K/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
