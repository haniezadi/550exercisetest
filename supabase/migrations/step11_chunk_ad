INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('کیک بک باسن سیمکش روی زمین', '', ARRAY['باسن']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['ماشین','کش']::text[], 'beginner', 'gym', 'خوابیده روی زمین، زانو خم، کف پا روی زمین. باسن را به سمت بالا فشار دهید تا تنه و ران‌ها در یک خط قرار گیرند. در بالا مکث کنید و با کنترل پایین بیاورید.', 'فشار از طریق پاشنه، نه کمر. در بالا انقباض باسن را احساس کنید.', 'در صورت درد کمر، فرم را اصلاح کنید یا وزنه را کاهش دهید.', 'https://drive.google.com/file/d/14OWX1m38wZefhrs3SfigtQ-_n8WlFp41/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پرس سینه اسمیت دست باز', 'Smith Machine Wide Grip Bench Press', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو','سرشانه']::text[], 'strength', ARRAY['ماشین','نیمکت']::text[], 'intermediate', 'gym', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1Pc3y6FA01beEhuCj3GE4yKjQNU21ws4J/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('زیر بغل دستگاه', '', ARRAY['پشت']::text[], ARRAY['پشت‌بازو','سرشانه']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'تنه را از کمر خم کنید، کمر صاف، نگاه به جلو. هالتر یا دمبل را با کنترل به سمت زیر شکم بکشید. آرنج‌ها نزدیک بدن، کتف‌ها فشرده شوند. در پایین مکث کنید و با کنترل رها کنید.', 'کمر صفت نگه دارید، از کمان‌برداری کمر خودداری کنید. کتف‌ها را در پایین فشرده کنید.', 'در صورت درد کمر، از وزنه سبک‌تر استفاده کنید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1CuEDCVJvaJusa6vtpi6If5zfUW2WUa1z/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت بازو کابل کراس اور', 'Cable Crossover Tricep Extension', ARRAY['پشت‌بازو']::text[], ARRAY['سینه']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'روی نیمکت دراز بکشید یا ایستاده، آرنج‌ها ثابت. دمبل یا هالتر را از پشت سر به سمت بالا باز کنید. آرنج‌ها نزدیک سر بمانند. با کنترل به وضعیت اولیه برگردید.', 'آرنج‌ها ثابت، نزدیک سر یا بدن بمانند. از باز شدن آرنج‌ها به بیرون خودداری کنید.', 'در صورت درد آرنج، از وزنه سبک‌تر استفاده کنید.', 'https://drive.google.com/file/d/1YV0N1ztz657nZK2E6qwcbm99VQVlPbgZ/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
