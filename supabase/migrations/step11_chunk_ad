INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('جلو بازو سیمکش دست عکس', '', ARRAY['جلو بازو']::text[], ARRAY['ساعد']::text[], 'strength', ARRAY['ماشین','کش']::text[], 'beginner', 'gym', 'ایستاده، پاها به عرض شانه، آرنج‌ها نزدیک بدن. هالتر یا دمبل را با کف دست به سمت بالا بکشید. آرنج‌ها ثابت بمانند. در بالا مکث کنید و با کنترل پایین بیاورید.', 'آرنج‌ها ثابت کنار بدن، تاب خوردن دست مجاز نیست. حرکت را کنترل و آرام انجام دهید.', 'در صورت درد مچ یا آرنج، وزنه را کاهش دهید.', 'https://drive.google.com/file/d/1U3Vk9DV-pEa3zXEF9B4wgh41r2mb50Jl/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('نشر خم دمبل نشسته', 'Seated Rear Delt Raise', ARRAY['کل‌بدن']::text[], ARRAY[]::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'gym', 'ایستاده، پاها به عرض شانه. حرکت را با فرم صحیح و کنترل کامل انجام دهید. تمام بدن درگیر است.', 'هماهنگی تنفس با حرکت، فرم صحیح اولویت دارد.', 'در صورت درد هر ناحیه، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1PS4nGWbtNYV2NAz4MJHS9BQh_TgJpu6r/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
