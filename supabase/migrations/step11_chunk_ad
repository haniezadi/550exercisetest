INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('نشر از جلو هالتر', '', ARRAY['سرشانه']::text[], ARRAY['ترپز','جلو بازو']::text[], 'strength', ARRAY['هالتر']::text[], 'intermediate', 'both', 'ایستاده، پاها به عرض شانه، شکم سفت. دمبل‌ها را در خط شانه نگه دارید. با بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها بالای سر صاف شوند. با کنترل به وضعیت اولیه برگردید.', 'شانه‌ها پایین و دور از گوش. قفسه سینه بالا، شکم سفت. از قفل کردن کامل آرنج در بالا خودداری کنید.', 'در صورت درد سرشانه یا کتف، زاویه را تغییر دهید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1OMwGdE4nN9ehZM29fOZdQ5X5k6nYWpkw/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
