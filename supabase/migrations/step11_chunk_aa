INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('لانج وزن بدن پرشی', '', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'cardio', ARRAY['بدون تجهیزات']::text[], 'beginner', 'both', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/18V-9qNqaNC5tAE0IivLc6X91shzt6hEu/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
