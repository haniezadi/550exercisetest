INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('ساق تک پا ایستاده', '', ARRAY['ساق']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'gym', 'ایستاده، نوک پنجه روی لبه دستگاه یا صفحه. با کنترل پایین بروید تا کشش کامل در ساق احساس شود. سپس با فشار نوک پنجه به بالا برگردید.', 'کشش کامل در پایین، انقباض کامل در بالا. مکث کوتاه در بالا برای انقباخت بهتر.', 'در صورت درد مچ پا یا تاندون آشیل، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/15VptXBWLIInARj-KOv6Z0lo4Xsft_Yu9/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('شنا با وزنه', 'Weighted Push Up', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1C9P7AY5LkHnfUKak3rheA8HXkSMfr1lk/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
