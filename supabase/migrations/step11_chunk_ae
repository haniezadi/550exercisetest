INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('نشر از جانب خوابیده تک دست', 'Powell Raise', ARRAY['کل‌بدن']::text[], ARRAY[]::text[], 'strength', ARRAY['بدون تجهیزات']::text[], 'beginner', 'gym', 'ایستاده، پاها به عرض شانه. حرکت را با فرم صحیح و کنترل کامل انجام دهید. تمام بدن درگیر است.', 'هماهنگی تنفس با حرکت، فرم صحیح اولویت دارد.', 'در صورت درد هر ناحیه، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1DISZwBd9m62CTVp6pv58F27XUx_9ixxG/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پشت بازو کابل کیک بک', 'Cable Tricep Kickback', ARRAY['پشت‌بازو']::text[], ARRAY['سینه']::text[], 'strength', ARRAY['ماشین']::text[], 'beginner', 'gym', 'روی نیمکت دراز بکشید یا ایستاده، آرنج‌ها ثابت. دمبل یا هالتر را از پشت سر به سمت بالا باز کنید. آرنج‌ها نزدیک سر بمانند. با کنترل به وضعیت اولیه برگردید.', 'آرنج‌ها ثابت، نزدیک سر یا بدن بمانند. از باز شدن آرنج‌ها به بیرون خودداری کنید.', 'در صورت درد آرنج، از وزنه سبک‌تر استفاده کنید.', 'https://drive.google.com/file/d/1DajAeXR5IHABYXLjhbD4evHsIhYr-JLI/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
