INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('فلای دمبل تک دست میز شیب منفی', 'Decline Single Arm Dumbbell Fly', ARRAY['سینه']::text[], ARRAY['جلو بازو','پشت‌بازو']::text[], 'strength', ARRAY['دمبل']::text[], 'beginner', 'both', 'روی نیمکت دراز بکشید، کمر تخت، پاها روی زمین. دمبل‌ها یا هالتر را در خط سینه نگه دارید. هنگام بازدم، وزنه را به سمت بالا فشار دهید تا دست‌ها صاف شوند. در بالا، مکث کوتاه کنید و سپس با کنترل به وضعیت اولیه برگردید.', 'کمر تخت روی نیمکت، آرنج‌ها در زاویه حدود ۴۵ درجه نسبت به بدن. وزنه را کنترل کنید، افت ندهید.', 'در صورت درد سرشانه یا مچ دست، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/13FTK8E7ndqX1BqnVjmMTZo0w7_ZB7EnJ/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('سومو ددلیفت دمبل  (پا باز)', '', ARRAY['پشت‌ران']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['دمبل']::text[], 'advanced', 'both', 'ایستاده یا خوابیده روی دستگاه. با کنترل پاشنه‌ها را به سمت باسن بکشید. در بالا مکث کنید و با کنترل رها کنید. کمر صفت نگه دارید.', 'کشش کامل در پایین، انقباض کامل در بالا. از تاب خوردن دستگاه خودداری کنید.', 'در صورت درد زانو یا کمر، حرکت را متوقف کنید.', 'https://drive.google.com/file/d/10vca9UsMXga-Rbzq-9IDafugkobCRSj-/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
