INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('اسپلیت اسکوات کوتاه دمبل', 'Dumbbell Short Split Squat', ARRAY['چهارسر']::text[], ARRAY['باسن','پشت‌ران']::text[], 'strength', ARRAY['دمبل']::text[], 'intermediate', 'both', 'پاها به عرض شانه، نوک پنجه کمی به بیرون. با کنترل پایین بروید تا ران‌ها موازی زمین شوند. زانوها از نوک پنجه جلوتر نروند. کمر صاف، سینه بالا. با فشار پاشنه به بالا برگردید.', 'زانوها در جهت نوک پنجه، از گردش به داخل یا خارج خودداری کنید. عمق حرکت را به‌تدریج افزایش دهید.', 'در صورت درد زانو یا کمر، عمق حرکت را کاهش دهید یا متوقف کنید.', 'https://drive.google.com/file/d/16xUlX7OYVi010JVR8ZaAT1L1q_6EHjdg/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
INSERT INTO exercises (name_fa, name_en, primary_muscles, secondary_muscles, exercise_type, equipment, difficulty, location, instructions, tips, limitations, video_url, is_active, is_favorite, tags, coach_notes) VALUES ('پارویی هالتر٬ خم دست باز', '', ARRAY['پشت']::text[], ARRAY['پشت‌بازو','سرشانه']::text[], 'strength', ARRAY['هالتر']::text[], 'intermediate', 'both', 'تنه را از کمر خم کنید، کمر صاف، نگاه به جلو. هالتر یا دمبل را با کنترل به سمت زیر شکم بکشید. آرنج‌ها نزدیک بدن، کتف‌ها فشرده شوند. در پایین مکث کنید و با کنترل رها کنید.', 'کمر صفت نگه دارید، از کمان‌برداری کمر خودداری کنید. کتف‌ها را در پایین فشرده کنید.', 'در صورت درد کمر، از وزنه سبک‌تر استفاده کنید یا حرکت را متوقف کنید.', 'https://drive.google.com/file/d/1ZLieMpnBJ9AsnTNt9NeIzC38jexkAgKI/view?usp=sharing', true, false, ARRAY[]::text[], '') ON CONFLICT (name_fa) DO NOTHING;
